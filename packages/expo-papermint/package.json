{
  "name": "expo-papermint",
  "version": "0.3.0",
  "description": "High-performance receipt and label compilation engine for Expo & React Native",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-papermint",
    "ExpoPapermint"
  ],
  "repository": "https://github.com/zerathlabs/papermint",
  "bugs": {
    "url": "https://github.com/zerathlabs/papermint/issues"
  },
  "author": "Papermint Team <dev.mohammedsh@gmail.com> (https://github.com/mohxmd)",
  "license": "MIT",
  "homepage": "https://papermint.zerathlabs.com",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "ios",
    "android",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.21",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.0.0",
    "react-native": "0.82.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
